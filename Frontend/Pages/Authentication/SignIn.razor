@page "/authentication/sign-in"
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Authorization
<PageTitle>PC Master - Log In</PageTitle>

<div class="auth-page">
    <div class="bg-layer"></div>
    <div class="bg-img"></div>
    <div class="scan-lines"></div>

    <div class="page">
        <div class="left-panel">
            <div class="logo-wrap">
                <div class="logo-icon">
                    <svg class="keyboard-svg" viewBox="0 0 90 70" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="4" y="18" width="58" height="40" rx="4" stroke="white" stroke-width="2.5" fill="none"/>
                        <rect x="10" y="24" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="20" y="24" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="30" y="24" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="40" y="24" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="50" y="24" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="10" y="33" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="20" y="33" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="30" y="33" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="40" y="33" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="50" y="33" width="6" height="5" rx="1" fill="white" opacity="0.7"/>
                        <rect x="10" y="42" width="6" height="5" rx="1" fill="#FF1A6C" opacity="0.9"/>
                        <rect x="20" y="42" width="6" height="5" rx="1" fill="#FF1A6C" opacity="0.9"/>
                        <rect x="30" y="42" width="14" height="5" rx="1" fill="#FF1A6C" opacity="0.9"/>
                        <rect x="48" y="42" width="8" height="5" rx="1" fill="#FF1A6C" opacity="0.9"/>
                        <path d="M65 30 L75 10 L85 30" stroke="#00D4FF" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        <line x1="68" y1="24" x2="82" y2="24" stroke="#00D4FF" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="75" cy="46" r="5" stroke="#00D4FF" stroke-width="2" fill="none"/>
                        <line x1="75" y1="35" x2="75" y2="41" stroke="#00D4FF" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="logo-title">PC<br>MASTER</div>
                <div class="logo-sub">Tech Minds</div>
            </div>
        </div>

        <div class="right-panel">
            <div class="login-card">
                <div class="login-title">Log In</div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">@errorMessage</div>
                }

                <EditForm Model="model" OnValidSubmit="HandleSignIn" FormName="signin-form">
                    <div class="field">
                        <input type="text" @bind="model.UserName" placeholder="User" />
                    </div>
                    <div class="field">
                        <input type="password" @bind="model.Password" placeholder="Password" />
                    </div>
                    <button type="submit" class="btn-submit" disabled="@isLoading">
                        @(isLoading ? "Signing in..." : "Submit")
                    </button>
                </EditForm>

                <div class="forgot">Forgot your password?</div>
                <a href="/authentication/sign-up" class="btn-register">Register now</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private IAuthenticationService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private SignInRequest model = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleSignIn()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            var result = await AuthService.SignInAsync(model);
            if (result is not null)
            {
                Navigation.NavigateTo("/home", forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid credentials. Try again.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Server connection error. Verify the backend is running.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
