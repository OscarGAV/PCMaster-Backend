@page "/technical-supports/create"
@attribute [Authorize]

<PageTitle>Nuevo Ticket - PC Master</PageTitle>

<div class="page-header">
    <a href="/technical-supports" class="btn-link-sm">&larr; Volver</a>
    <h1>Crear Ticket de Soporte</h1>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-error">@errorMessage</div>
}

<div class="form-container">
    <EditForm Model="model" OnValidSubmit="HandleCreate" FormName="create-ts-form">
        <div class="form-row">
            <div class="form-group">
                <label for="techId">ID Técnico</label>
                <InputText id="techId" @bind-Value="model.TechnicianId" class="form-control" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="supportType">Tipo de Soporte</label>
                <InputCheckbox id="supportType" @bind-Value="model.SupportType" />
                <span class="checkbox-label">Presencial (@(model.SupportType ? "Sí" : "Zoom/Remoto"))</span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="dateRequest">Fecha Solicitud</label>
                <InputDate id="dateRequest" @bind-Value="model.DateOfRequest" class="form-control" />
            </div>
            <div class="form-group">
                <label for="startDate">Fecha Inicio</label>
                <InputDate id="startDate" @bind-Value="model.StartDate" class="form-control" />
            </div>
            <div class="form-group">
                <label for="endDate">Fecha Fin</label>
                <InputDate id="endDate" @bind-Value="model.EndDate" class="form-control" />
            </div>
        </div>
        <button type="submit" class="btn-primary" disabled="@isLoading">
            @(isLoading ? "Creando..." : "Crear Ticket")
        </button>
    </EditForm>
</div>

@code {
    [Inject] private ITechnicalSupportService TsService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private CreateTechnicalSupportRequest model = new()
    {
        DateOfRequest = DateTime.Today,
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(1)
    };
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleCreate()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            await TsService.CreateAsync(model);
            Navigation.NavigateTo("/technical-supports");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
