@page "/technicians/create"
@attribute [Authorize(Roles = PCMasterFrontend.Infrastructure.Constants.ERole.ROLE_ADMIN)]

<PageTitle>Nuevo Técnico - PC Master</PageTitle>

<div class="page-header">
    <a href="/technicians" class="btn-link-sm">&larr; Volver a Técnicos</a>
    <h1>Crear Técnico</h1>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-error">@errorMessage</div>
}

@if (createdCredentials is not null)
{
    <div class="alert alert-success">
        <strong>Técnico creado exitosamente.</strong><br />
        <strong>Credenciales de acceso:</strong><br />
        Usuario: <code>@createdCredentials.Username</code><br />
        Contraseña: <code>@createdCredentials.Password</code><br />
        <small>Guarda estas credenciales, no se mostrarán de nuevo.</small>
    </div>
}

<div class="form-container">
    <EditForm Model="model" OnValidSubmit="HandleCreate" FormName="create-tech-form">
        <div class="form-row">
            <div class="form-group">
                <label for="name">Nombre</label>
                <InputText id="name" @bind-Value="model.Name" class="form-control" />
            </div>
            <div class="form-group">
                <label for="img">URL de Imagen</label>
                <InputText id="img" @bind-Value="model.Img" class="form-control" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="status">Estado</label>
                <InputCheckbox id="status" @bind-Value="model.Status" />
                <span class="checkbox-label">Disponible</span>
            </div>
        </div>
        <button type="submit" class="btn-primary" disabled="@isLoading">
            @(isLoading ? "Creando..." : "Crear Técnico")
        </button>
    </EditForm>
</div>

@code {
    [Inject] private ITechnicianService TechnicianService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private CreateTechnicianRequest model = new();
    private string? errorMessage;
    private bool isLoading;
    private CreatedCredentials? createdCredentials;

    private async Task HandleCreate()
    {
        errorMessage = null;
        isLoading = true;
        createdCredentials = null;
        try
        {
            var result = await TechnicianService.CreateAsync(model);
            if (result is not null)
            {
                createdCredentials = new CreatedCredentials
                {
                    Username = result.Username,
                    Password = result.Password
                };
                model = new CreateTechnicianRequest();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class CreatedCredentials
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
