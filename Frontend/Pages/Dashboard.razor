@page "/home"
@attribute [Authorize]

<PageTitle>PC Master - Inicio</PageTitle>

<section class="hero-section">
    <div class="hero-content">
        <h1>PC Master Platform</h1>
        <p>Tu plataforma integral para componentes de PC, soporte técnico y más.</p>
        <div class="hero-actions">
            <a href="/components" class="btn-primary btn-lg">Explorar Componentes</a>
            <a href="/technical-supports" class="btn-outline btn-lg">Soporte Técnico</a>
        </div>
    </div>
</section>

<section class="features-section">
    <h2>Secciones Principales</h2>
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">&#128187;</div>
            <h3>Componentes</h3>
            <p>Explora y gestiona el catálogo completo de componentes de PC con especificaciones detalladas.</p>
            <a href="/components" class="btn-link">Ver componentes &rarr;</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">&#128295;</div>
            <h3>Técnicos</h3>
            <p>Conoce a nuestros técnicos especializados con valoraciones y disponibilidad actualizada.</p>
            <a href="/technicians" class="btn-link">Ver técnicos &rarr;</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">&#128172;</div>
            <h3>Soporte Técnico</h3>
            <p>Solicita asistencia técnica presencial o remota con seguimiento de tus tickets.</p>
            <a href="/technical-supports" class="btn-link">Ver soporte &rarr;</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">&#128722;</div>
            <h3>Carrito</h3>
            <p>Gestiona tus compras de componentes con facilidad y seguimiento de tus pedidos.</p>
            <a href="/cart" class="btn-link">Ver carrito &rarr;</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">&#10084;</div>
            <h3>Wishlist</h3>
            <p>Guarda tus componentes favoritos y recibe notificaciones de disponibilidad.</p>
            <a href="/wishlist" class="btn-link">Ver wishlist &rarr;</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">&#11088;</div>
            <h3>Reseñas</h3>
            <p>Lee y comparte opiniones sobre componentes y servicios de soporte técnico.</p>
            <a href="/components" class="btn-link">Ver reseñas &rarr;</a>
        </div>
    </div>
</section>

<section class="stats-section">
    <div class="stats-container">
        <div class="stat-item">
            <h3>100%</h3>
            <p>Confiable</p>
        </div>
        <div class="stat-item">
            <h3>24/7</h3>
            <p>Soporte</p>
        </div>
        <div class="stat-item">
            <h3>Calidad</h3>
            <p>Garantizada</p>
        </div>
    </div>
</section>
