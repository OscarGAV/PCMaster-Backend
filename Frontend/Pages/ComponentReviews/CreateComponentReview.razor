@page "/component-reviews/create/{ComponentId:int}"
@attribute [Authorize(Roles = PCMasterFrontend.Infrastructure.Constants.ERole.ROLE_CLIENTE)]
@using PCMasterFrontend.Infrastructure.Exceptions

<PageTitle>Crear Reseña - PC Master</PageTitle>

<div class="page-header">
    <a href="/component-reviews/@ComponentId" class="btn-link-sm">&larr; Volver</a>
    <h1>Crear Reseña para Componente #@ComponentId</h1>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-error">@errorMessage</div>
}

<div class="form-container">
    <EditForm Model="model" OnValidSubmit="HandleCreate" FormName="create-cr-form">
        <div class="form-group">
            <label for="userName">Nombre de Usuario</label>
            <InputText id="userName" @bind-Value="model.UserName" class="form-control" />
        </div>
        <div class="form-group">
            <label for="rating">Calificación (1-5)</label>
            <InputNumber id="rating" @bind-Value="model.Rating" class="form-control" />
        </div>
        <div class="form-group">
            <label for="comment">Comentario</label>
            <InputTextArea id="comment" @bind-Value="model.Comment" class="form-control" rows="3" />
        </div>
        <button type="submit" class="btn-primary" disabled="@isLoading">
            @(isLoading ? "Creando..." : "Publicar Reseña")
        </button>
    </EditForm>
</div>

@code {
    [Inject] private IComponentReviewService ReviewService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter] public int ComponentId { get; set; }

    private CreateComponentReviewRequest model = new();
    private string? errorMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        model.ComponentId = ComponentId;
    }

    private async Task HandleCreate()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            await ReviewService.CreateAsync(model);
            Navigation.NavigateTo($"/component-reviews/{ComponentId}");
        }
        catch (ForbiddenAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
