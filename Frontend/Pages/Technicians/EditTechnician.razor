@page "/technicians/{Id:int}/edit"
@attribute [Authorize]

<PageTitle>Editar Técnico - PC Master</PageTitle>

<div class="page-header">
    <a href="/technicians/@Id" class="btn-link-sm">&larr; Volver</a>
    <h1>Editar Técnico</h1>
</div>

@if (isLoading)
{
    <div class="loading">Cargando...</div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-error">@errorMessage</div>
}
else if (model is not null)
{
    <div class="form-container">
        <EditForm Model="model" OnValidSubmit="HandleUpdate" FormName="edit-tech-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="name">Nombre</label>
                    <InputText id="name" @bind-Value="model.Name" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="img">URL de Imagen</label>
                    <InputText id="img" @bind-Value="model.Img" class="form-control" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="status">Estado</label>
                    <InputCheckbox id="status" @bind-Value="model.Status" />
                    <span class="checkbox-label">Disponible</span>
                </div>
                <div class="form-group">
                    <label for="stars">Estrellas (0-5)</label>
                    <InputNumber id="stars" @bind-Value="model.Stars" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn-primary" disabled="@isSaving">
                @(isSaving ? "Guardando..." : "Guardar Cambios")
            </button>
        </EditForm>
    </div>
}

@code {
    [Inject] private ITechnicianService TechnicianService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter] public int Id { get; set; }

    private UpdateTechnicianRequest? model;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tech = await TechnicianService.GetByIdAsync(Id);
            if (tech is not null)
            {
                model = new UpdateTechnicianRequest
                {
                    Name = tech.Name,
                    Status = tech.Status,
                    Stars = tech.Stars,
                    Img = tech.Img
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (model is null) return;
        errorMessage = null;
        isSaving = true;
        try
        {
            await TechnicianService.UpdateAsync(Id, model);
            Navigation.NavigateTo("/technicians");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
