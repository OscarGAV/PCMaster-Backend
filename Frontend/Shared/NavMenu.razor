@using Microsoft.AspNetCore.Components.Authorization
@using PCMasterFrontend.Infrastructure.Constants
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation

<nav class="navbar">
    <div class="navbar-container">
        <a href="/" class="navbar-brand">
            <span class="brand-icon">&#9881;</span>
            <span class="brand-text">PC Master</span>
        </a>

        <div class="navbar-links">
            <AuthorizeView>
                <Authorized>
                    <a href="/components" class="nav-link">Componentes</a>
                    <a href="/technicians" class="nav-link">Técnicos</a>
                    <a href="/technical-supports" class="nav-link">Soporte Técnico</a>
                    @if (context.User.IsInRole(ERole.ROLE_CLIENTE))
                    {
                        <a href="/cart" class="nav-link">Carrito</a>
                        <a href="/wishlist" class="nav-link">Wishlist</a>
                    }
                    @if (context.User.IsInRole(ERole.ROLE_ADMIN))
                    {
                        <a href="/users" class="nav-link">Usuarios</a>
                    }
                </Authorized>
                <NotAuthorized>
                    <a href="/components" class="nav-link">Componentes</a>
                    <a href="/technicians" class="nav-link">Técnicos</a>
                    <a href="/technical-supports" class="nav-link">Soporte Técnico</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="navbar-actions">
            <AuthorizeView>
                <Authorized>
                    <span class="nav-greeting">Hola, @context.User.Identity?.Name</span>
                    <span class="nav-role-badge">
                        @(context.User.IsInRole(ERole.ROLE_ADMIN) ? "Administrador" : context.User.IsInRole(ERole.ROLE_TECNICO) ? "Técnico" : "Cliente")
                    </span>
                    <button class="btn-logout" @onclick="Logout">Salir</button>
                </Authorized>
                <NotAuthorized>
                    <a href="/authentication/sign-in" class="btn-login">Iniciar Sesión</a>
                    <a href="/authentication/sign-up" class="btn-signup">Registrarse</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
